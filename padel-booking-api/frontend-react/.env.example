# URL de la API REST.
# En desarrollo puede quedarse vacío: Vite hace de proxy de /api hacia el backend
# (ver vite.config.js) y se usa la ruta relativa "/api/v1".
#
# En producción (build estático servido en otro dominio), define la URL absoluta:
# VITE_API_BASE=https://api.midominio.com/api/v1
VITE_API_BASE=

# Backend al que apunta el proxy de desarrollo de Vite (por defecto http://127.0.0.1:8000)
# VITE_BACKEND_URL=http://127.0.0.1:8000
