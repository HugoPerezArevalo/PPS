# --- App ---
ENVIRONMENT=development
# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=720
REFRESH_TOKEN_EXPIRE_DAYS=7
# bcrypt cost factor (12 in production, lower only for tests)
BCRYPT_ROUNDS=12

# --- Database ---
# SQLite by default; e.g. postgresql+psycopg://user:pass@localhost/padel
DATABASE_URL=sqlite:///./padel.db

# --- Booking rules ---
SLOT_MINUTES=30
MIN_BOOKING_MINUTES=30
MAX_BOOKING_HOURS=3
CANCEL_CUTOFF_HOURS=6
DEFAULT_OPEN_TIME=08:00
DEFAULT_CLOSE_TIME=23:00

# --- Seed data (dev) ---
SEED_ON_STARTUP=true
ADMIN_EMAIL=admin@padel.com
ADMIN_PASSWORD=Admin123!
PLAYER_EMAIL=player@padel.com
PLAYER_PASSWORD=Player123!

# --- CORS (JSON list) ---
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
